---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { CATEGORIES, AUTHORS } from '../data/site';
import { articles, excerpt, formatDate, type Post } from '../lib/posts';

export async function getStaticPaths() {
  return articles.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: Post };
const catLabel = page.category ? CATEGORIES[page.category] ?? page.category : '';

const related = articles
  .filter((p) => p.slug !== page.slug && p.category === page.category)
  .slice(0, 4);

const words = page.body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 220));

const headings = [...page.body.matchAll(/<h2[^>]*>(.*?)<\/h2>/gs)].map((m, i) => ({
  id: `sectie-${i + 1}`,
  text: m[1].replace(/<[^>]+>/g, '').trim(),
}));
let idx = 0;
const bodyWithIds = page.body.replace(/<h2([^>]*)>/g, () => `<h2 id="sectie-${++idx}">`);
---

<Base title={page.title} description={page.description || excerpt(page, 150)} canonical={`/${page.slug}/`} ogImage={page.image}>
  <article class="wrap article">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      {catLabel && <span>/</span>}
      {catLabel && <a href={`/category/${page.category}/`}>{catLabel}</a>}
    </nav>

    <header class="article-head">
      {catLabel && <a href={`/category/${page.category}/`} class="kicker">{catLabel}</a>}
      <h1>{page.h1}</h1>
      <p class="meta">
        {page.author && <>Door <a href={`/author/${page.author}/`}>{AUTHORS[page.author] ?? page.author}</a> &middot; </>}
        {formatDate(page.date)} &middot; Leestijd {readMin} {readMin === 1 ? 'minuut' : 'minuten'}
      </p>
    </header>

    {page.image && (
      <div class="article-hero">
        <img src={page.image} alt={page.h1} loading="eager" />
      </div>
    )}

    <div class="article-grid">
      <div class="prose" set:html={bodyWithIds} />
      <aside class="sidebar">
        {headings.length > 1 && (
          <div class="toc">
            <p class="sidebar-heading">In dit artikel</p>
            <ol>
              {headings.map((h) => (
                <li><a href={`#${h.id}`}>{h.text}</a></li>
              ))}
            </ol>
          </div>
        )}
        {related.length > 0 && (
          <div class="related">
            <p class="sidebar-heading">Lees ook</p>
            <ul>
              {related.map((r) => (
                <li><a href={`/${r.slug}/`}>{r.h1}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>

<style>
  .article { padding-top: 2rem; }
  .crumbs { font-size: 0.85rem; color: var(--text-faint); display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .crumbs a { color: var(--orange-600); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .article-head { margin: 1.4rem 0 1.8rem; max-width: 820px; }
  .kicker {
    display: inline-block; font-family: var(--font-head); font-size: 0.74rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--orange-700);
    font-weight: 700; margin-bottom: 0.7rem; background: var(--orange-50);
    border: 1px solid var(--orange-100); padding: 0.25rem 0.7rem; border-radius: 999px;
    text-decoration: none;
  }
  .article-head h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.15; margin-bottom: 0.7rem; }
  .meta { font-size: 0.9rem; color: var(--text-faint); }
  .meta a { color: var(--orange-600); text-decoration: none; }
  .meta a:hover { text-decoration: underline; }

  .article-hero {
    border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 2.2rem;
    max-height: 460px; box-shadow: var(--shadow-md);
  }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .article-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 3rem; }
  @media (max-width: 900px) { .article-grid { grid-template-columns: 1fr; } }

  .sidebar { position: relative; }
  .toc, .related {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 1.3rem; margin-bottom: 1.5rem;
  }
  .toc { position: sticky; top: 5.8rem; }
  .sidebar-heading {
    font-family: var(--font-head); font-size: 0.75rem; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--sage-600); font-weight: 700; margin-bottom: 0.8rem;
  }
  .toc ol { margin: 0; padding-left: 1.2rem; }
  .toc li, .related li { margin-bottom: 0.5rem; font-size: 0.92rem; }
  .toc a, .related a { color: var(--text-soft); text-decoration: none; }
  .toc a:hover, .related a:hover { color: var(--orange-700); text-decoration: underline; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related a { color: var(--orange-600); }
</style>
