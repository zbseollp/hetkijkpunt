---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { AUTHORS, CATEGORIES } from '../../data/site';
import { byAuthor, excerpt, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  return Object.keys(AUTHORS).map((author) => ({ params: { author } }));
}

const { author } = Astro.params;
const name = AUTHORS[author!] ?? author;
const items = byAuthor(author!);
---

<Base title={`Artikelen van ${name} | Hetkijkpunt`} description={`Alle artikelen geschreven door ${name} op Hetkijkpunt.`} canonical={`/author/${author}/`}>
  <section class="wrap listing">
    <header class="listing-head">
      <p class="kicker">Auteur</p>
      <h1>{name}</h1>
      <p>{items.length} {items.length === 1 ? 'artikel' : 'artikelen'} van deze auteur.</p>
    </header>

    <div class="card-grid">
      {items.map((p) => (
        <a href={`/${p.slug}/`} class="post-card">
          <div class="thumb">{p.image ? <img src={p.image} alt="" loading="lazy" /> : <span class="ph-icon" />}</div>
          <div class="card-body">
            {p.category && <span class="cat-badge">{CATEGORIES[p.category] ?? p.category}</span>}
            <h3>{p.h1}</h3>
            <p>{excerpt(p)}</p>
            <span class="card-meta">{formatDate(p.date)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .listing { padding-top: 2.5rem; }
  .listing-head { margin-bottom: 2rem; }
  .kicker {
    display: inline-block; font-family: var(--font-head); font-size: 0.74rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--orange-700);
    font-weight: 700; margin-bottom: 0.7rem; background: var(--orange-50);
    border: 1px solid var(--orange-100); padding: 0.25rem 0.7rem; border-radius: 999px;
  }
  .listing-head h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.4rem; }
  .listing-head p { color: var(--text-soft); }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.2rem; }
</style>
