---
export const prerender = true;
import Base from '../layouts/Base.astro';
import statics from '../data/statics.json';

const blocks = (statics as Record<string, [string, string][]>)['contact'];
---

<Base title="Contact | Hetkijkpunt" description="Heb je een vraag, tip of wil je met ons samenwerken? Neem contact op met de redactie van Hetkijkpunt." canonical="/contact/">
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact</h1>
    </div>
  </section>
  <section class="wrap page-body">
    <div class="contact-grid">
      <div class="prose">
        {blocks.map(([tag, text]) =>
          tag === 'h2' || tag === 'h3' ? <h2>{text}</h2> : <p>{text}</p>
        )}
      </div>
      <form class="contact-form" id="contactForm" onsubmit="return sendContactForm(event)">
        <div class="form-row">
          <div>
            <label for="cf-voornaam">Voornaam</label>
            <input id="cf-voornaam" name="voornaam" type="text" required autocomplete="given-name" />
          </div>
          <div>
            <label for="cf-achternaam">Achternaam</label>
            <input id="cf-achternaam" name="achternaam" type="text" autocomplete="family-name" />
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="cf-email">E-mail Adres</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div>
            <label for="cf-tel">Telefoonnummer</label>
            <input id="cf-tel" name="telefoon" type="tel" autocomplete="tel" />
          </div>
        </div>
        <label for="cf-onderwerp">Onderwerp</label>
        <input id="cf-onderwerp" name="onderwerp" type="text" required />
        <label for="cf-bericht">Bericht</label>
        <textarea id="cf-bericht" name="bericht" rows="6" required></textarea>

        <div class="captcha-box">
          <div class="h-captcha" data-sitekey="281f477d-7744-407d-9b6a-9b8d9c6abe3c"></div>
          <p class="captcha-err" id="capErr" hidden>Bevestig eerst dat je geen robot bent.</p>
        </div>

        <button type="submit" class="submit-btn">Verzenden</button>
        <p class="form-success" id="cfSuccess" hidden>&#10003; Je bericht is klaargezet in je e-mailprogramma. Verstuur hem daar om hem te verzenden.</p>
      </form>
    </div>
  </section>

  <script is:inline src="https://js.hcaptcha.com/1/api.js" async defer></script>
  <script is:inline>
    window.sendContactForm = function (ev) {
      ev.preventDefault();
      var v = function (id) { return document.getElementById(id).value; };
      var token = window.hcaptcha ? window.hcaptcha.getResponse() : '';
      if (!token) {
        document.getElementById('capErr').hidden = false;
        return false;
      }
      document.getElementById('capErr').hidden = true;
      var body =
        'Naam: ' + v('cf-voornaam') + ' ' + v('cf-achternaam') + '\n' +
        'E-mail: ' + v('cf-email') + '\n' +
        'Telefoon: ' + (v('cf-tel') || '-') + '\n\n' +
        v('cf-bericht');
      var url =
        'mailto:redactie@hetkijkpunt.nl?subject=' + encodeURIComponent(v('cf-onderwerp')) +
        '&body=' + encodeURIComponent(body);
      window.location.href = url;
      document.getElementById('cfSuccess').hidden = false;
      return false;
    };
  </script>
</Base>

<style>
  .page-hero { background: linear-gradient(120deg, var(--ink), #3a4d35 70%); }
  .page-hero .wrap { padding-block: 3rem; }
  .page-hero h1 { color: #fff; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; }
  .page-body { padding-top: 2.5rem; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 3rem; align-items: start; }
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-form {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 520px) { .form-row { grid-template-columns: 1fr; } }
  .contact-form label {
    display: block; font-family: var(--font-head); font-weight: 600; font-size: 0.9rem;
    margin-bottom: 0.35rem; color: var(--text);
  }
  .contact-form input, .contact-form textarea {
    width: 100%; padding: 0.65rem 0.85rem; margin-bottom: 1.1rem;
    border: 1.5px solid var(--line); border-radius: 10px;
    font-family: var(--font-body); font-size: 1rem; color: var(--text); background: #fff;
  }
  .contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--orange-500); }
  .captcha-box { margin-bottom: 1.2rem; }
  .captcha-err { color: #c0392b; font-size: 0.88rem; margin-top: 0.4rem; }

  .submit-btn {
    background: var(--orange-500); color: #fff; border: 0; cursor: pointer;
    font-family: var(--font-head); font-weight: 700; font-size: 1rem;
    padding: 0.75rem 1.8rem; border-radius: 10px; transition: background 0.15s;
  }
  .submit-btn:hover { background: var(--orange-600); }
  .form-success { margin-top: 1rem; color: var(--sage-600); font-weight: 600; font-size: 0.95rem; }
</style>
